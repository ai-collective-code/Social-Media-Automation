#####################################################################
# Social Automation Platform — credentials
#
# HOW TO USE:
#   1. Copy this file to `.env.local`  (same folder: web/.env.local)
#   2. Fill in ONLY the section you're working on
#   3. Restart the dev server after any change
#
# NOTES:
#   - `.env.local` is gitignored. This template is not (it has no secrets).
#   - Never add the NEXT_PUBLIC_ prefix to anything here — that would expose
#     the secret to the browser. All of these are server-only.
#   - Leave anything you don't need yet blank. Nothing breaks.
#####################################################################


#####################################################################
# PHASE A — LLM PROVIDER.  ← START HERE. Only section that's required.
#
# Powers workflows 2-5: trend analysis, content strategy, content
# bucketing, creative briefs, and caption writing.
#
# Provider-agnostic: works with ANY OpenAI-compatible API. Switching
# provider means editing the three lines below — no code changes.
#
# Preconfigured for GLM-5.2 on NVIDIA NIM (1M context window).
# Get a key: https://build.nvidia.com/z-ai/glm-5.2 -> "Get API Key"
# Free credits on signup. Key starts with "nvapi-".
#####################################################################

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=z-ai/glm-5.2
LLM_API_KEY=

# --- Claude (Anthropic) — RECOMMENDED, and much faster ---------------
# Anthropic's API is NOT OpenAI-compatible, so it does not go in the
# LLM_ values above; it has its own adapter (src/lib/anthropic.ts).
#
# Setting this key is all it takes: when ANTHROPIC_API_KEY is present it
# TAKES PRECEDENCE over the LLM_ settings above, and all six pipeline
# stages use Claude. Leave it blank to keep using the LLM_ provider.
#
# Why it's faster: GLM-5.2 is a reasoning model measured at 190-341s per
# call, so a full six-stage run takes ~25 minutes. Claude at medium
# effort typically brings that down to a few minutes.
#
# Get a key: https://console.anthropic.com/settings/keys  (starts "sk-ant-")
ANTHROPIC_API_KEY=

# OPTIONAL. Defaults to claude-opus-5.
# Cheaper/faster alternatives: claude-sonnet-5, claude-haiku-4-5
ANTHROPIC_MODEL=

# OPTIONAL. Stronger model for the creative-brief stage only.
# Leave blank to use ANTHROPIC_MODEL.
ANTHROPIC_MODEL_CREATIVE=

# OPTIONAL. Reasoning depth vs speed: low | medium | high | xhigh | max
# Defaults to "medium". Use "low" for the fastest runs, "high" for more
# thorough competitor research.
ANTHROPIC_EFFORT=

# OPTIONAL: use a different (stronger) model for the creative steps only —
# insight discovery, creative briefs, and caption writing. Reasoning-tuned
# models are excellent at strategy but can be weaker at brand voice and
# hooks, so this lets you upgrade just that step. Leave blank to use LLM_MODEL.
LLM_MODEL_CREATIVE=

# --- Alternative providers -------------------------------------------
# To switch, replace the three LLM_ values above with one of these sets.
#
# OpenRouter — one key, 300+ models (incl. Gemini/GPT/Claude), has free tiers
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=z-ai/glm-4.6              (or google/gemini-2.5-flash, etc.)
#
# Google Gemini — generous genuinely-free tier, strong long-form writing
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
#
# Groq — free tier, very fast
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.3-70b-versatile
#
# DeepSeek — not free but very cheap
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# ---------------------------------------------------------------------


#####################################################################
# PHASE B — VIDEO GENERATION (workflow 6, Stream B).
# Optional. Leave blank and video stays marked "not wired up" in the UI.
#####################################################################

# Which provider to route video jobs to: fal | replicate | higgsfield
VIDEO_PROVIDER=

# The matching API key for the provider above.
#   fal.ai      -> fal.ai/dashboard/keys   (one key -> Kling, MiniMax, Wan, Veo)
#   Replicate   -> replicate.com/account/api-tokens
#   Higgsfield  -> you may already hold this key from your existing skill
VIDEO_API_KEY=

# Optional: pin a specific video model, e.g. fal-ai/kling-video/v2/standard
VIDEO_MODEL=


#####################################################################
# PHASE C — IMAGES (workflow 6, Stream A). RECOMMENDED.
#
# With this key set, clicking "Generate image" on a creative brief calls
# OpenAI directly and writes a finished PNG immediately — no queue, no
# separate Claude session to complete it.
#
# Without it, image generation falls back to the original Canva flow: a
# job is queued, and a Claude session with Canva MCP access has to run
# it later. That flow still works and needs no key — this is a faster
# alternative, not a required upgrade.
#
# Get a key: https://platform.openai.com/api-keys  (starts "sk-")
#####################################################################

OPENAI_API_KEY=

# OPTIONAL. Defaults to gpt-image-2.
OPENAI_IMAGE_MODEL=

# --- Free testing fallback (Pollinations.ai) — no key, no billing ---------
# Only used when OPENAI_API_KEY above is unset — it never overrides a
# configured paid provider, even if that provider errors. Watermarked, and
# rate-limited to one image per 15 seconds. Fine for trying the pipeline;
# not for a real client asset.
POLLINATIONS_ENABLED=true


#####################################################################
# PHASE D — AUTOMATED COMPETITOR SCRAPING (workflow 1).
#
# OPTIONAL — competitor research currently runs via browser tooling in a
# Claude session with no key at all. Only needed to run it unattended.
#
# Instagram/TikTok have no public read API for other people's profiles;
# Apify runs maintained scrapers so you skip four app-review processes.
# console.apify.com -> Settings -> Integrations -> Personal API token
# NOTE: you may already have this from your insta-audit skill.
#####################################################################

APIFY_API_TOKEN=

# --- Web search (Tavily) — RECOMMENDED, fixes the blocked-scraper failure ---
# Without this, search falls back to scraping DuckDuckGo Lite with no key.
# That works for a run or two, then DDG's bot detection blocks the IP and
# research stages fail with "the search engine is temporarily blocking
# automated queries" — it blocks by IP, so restarting the app does not help.
#
# Tavily also returns extracted page text with each result, so the pipeline
# stops separately re-fetching every page. That removes about half the request
# volume per run and most of the wall-clock time in the research stages.
#
# Free tier is enough for several runs a day: https://app.tavily.com
# Key starts with "tvly-".
TAVILY_API_KEY=


#####################################################################
# PHASE E — PUBLISHING (workflow 7). LEAVE FOR LAST.
#
# ⚠️  These are NOT simple API keys. Every platform below gates automated
#     posting behind an app review taking days-to-weeks, and requires a
#     business account. Read CREDENTIALS.md before starting any of these.
#####################################################################

# --- Instagram + Facebook (Meta Graph API) ---
# Requires: IG Business/Creator account linked to a Facebook Page, a Meta
# app, AND App Review approval for instagram_content_publish.
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- TikTok (Content Posting API) ---
# Unaudited apps can only post PRIVATE videos — know this before investing.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- LinkedIn ---
# Personal posting is straightforward; posting AS a company page needs
# Community Management API approval.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_URN=

# --- YouTube (optional) ---
# Easiest of the four. Google Cloud Console -> YouTube Data API v3 -> OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
