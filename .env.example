#####################################################################
# Social Automation Platform — credentials template
#
# HOW TO USE:
#   1. Copy this file to `.env.local` (same folder: web/.env.local)
#   2. Fill in ONLY the section you're currently working on
#   3. Restart the dev server after any change
#
# NOTES:
#   - `.env.local` is gitignored. This template is not (it has no secrets).
#   - Do NOT add the NEXT_PUBLIC_ prefix to any of these. That would
#     expose the secret to the browser. All of these are server-only.
#   - Leave anything you don't need yet blank. Nothing breaks.
#####################################################################


#####################################################################
# PHASE A — REQUIRED FIRST. Unlocks workflows 2–5.
# (Trend Analysis, Content Strategy, Bucketing, Creative Director,
#  plus caption writing.) This one key does the most work by far.
#####################################################################

# console.anthropic.com -> API keys. Starts with "sk-ant-".
# Pay-as-you-go, no approval process, works immediately.
ANTHROPIC_API_KEY=


#####################################################################
# PHASE B — Competitor data collection (workflow 1, automated).
# OPTIONAL: today I do this research via browser in chat, no key needed.
# Only fill this in if you want it to run unattended.
#####################################################################

# console.apify.com -> Settings -> Integrations -> API token.
# Scrapes Instagram/TikTok/LinkedIn profiles + posts without needing
# each platform's official API or app review. Easiest path by far.
# NOTE: you may already have this configured for your insta-audit skill.
APIFY_API_TOKEN=

# OPTIONAL: only if you want audio/video transcription of competitor
# reels (platform.openai.com -> API keys). Whisper is used for this.
OPENAI_API_KEY=


#####################################################################
# PHASE C — Content execution (workflow 6): images + video.
# Pick ONE image option and ONE video option. You don't need all.
#####################################################################

# --- IMAGES ---

# OPTION 1 (recommended): You already have Canva connected via MCP,
# so image generation may need NO key at all. Try that route first.
# Only fill these if you want the website itself to call Canva directly:
# canva.com/developers -> Your integrations -> OAuth credentials.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# --- VIDEO (pick one) ---

# OPTION 1: Higgsfield — you already have a higgsfield-generator skill,
# so you may already hold this key.
HIGGSFIELD_API_KEY=

# OPTION 2: Runway (dev.runwayml.com)
RUNWAYML_API_SECRET=

# OPTION 3: Kling (klingai.com -> API console)
KLING_ACCESS_KEY=
KLING_SECRET_KEY=


#####################################################################
# PHASE D — PUBLISHING (workflow 7). LEAVE THIS FOR LAST.
#
# ⚠️  Heads up, this is the hard one. These are NOT simple API keys:
#     every platform below gates automated posting behind an app
#     review that takes days-to-weeks and needs a business account.
#     Read CREDENTIALS.md before starting any of these.
#####################################################################

# --- INSTAGRAM + FACEBOOK (Meta Graph API) ---
# Requires: Instagram BUSINESS or CREATOR account, linked to a Facebook
# Page, a Meta app, AND App Review for content_publish permission.
META_APP_ID=
META_APP_SECRET=
META_LONG_LIVED_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- TIKTOK (Content Posting API) ---
# Requires audited app status. Unaudited apps can only post PRIVATE
# videos — worth knowing before you invest time here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- LINKEDIN ---
# Personal posting is straightforward; posting AS a company page
# requires the Community Management API (approval needed).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ORG_URN=

# --- YOUTUBE (optional) ---
# Google Cloud Console -> YouTube Data API v3 -> OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
